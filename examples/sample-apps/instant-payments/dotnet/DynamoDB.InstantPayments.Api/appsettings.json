{
  "DynamoDb": {
    "Region": "eu-west-1",
    "TableName": "MyApplication",
    "AccountsTableName": "MyApplication-Accounts",
    "RepositoryProvider": "LowLevel",
    "EntityIndexName": "GSI1",
    "IdempotencyTtlSeconds": 86400,
    "SeedAccountIds": [
      "DEBTOR-0001",
      "DEBTOR-0002",
      "DEBTOR-0003"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
